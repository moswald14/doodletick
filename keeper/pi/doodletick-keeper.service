[Unit]
Description=Doodle Tick local Keeper
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=doodletick-keeper
Group=doodletick-keeper
WorkingDirectory=/opt/doodletick-keeper/current
ExecStart=/opt/doodletick-keeper/node-v24.22.3/bin/node /opt/doodletick-keeper/current/server.mjs
Environment=DOODLETICK_PORT=4317
Environment=DOODLETICK_DATA=/var/lib/doodletick-keeper
Environment=DOODLETICK_LOCK_DIR=/run/doodletick-keeper
StateDirectory=doodletick-keeper
StateDirectoryMode=0700
RuntimeDirectory=doodletick-keeper
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
