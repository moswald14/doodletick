diff --git a/src/test/doodleverse_tests.cpp b/src/test/doodleverse_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b6adc5b0b647e60a9f554abe8f317468a371bf11
--- /dev/null
+++ b/src/test/doodleverse_tests.cpp
@@ -0,0 +1,242 @@
+// Copyright (c) 2026 The Doodleverse developers
+// SPDX-License-Identifier: GPL-3.0-only
+// See the GPLv3 text in the Doodle Tick repository's root LICENSE and in
+// the accompanying distribution. Upstream MIT notices remain unchanged.
+
+#include "arith_uint256.h"
+#include "chainparams.h"
+#include "consensus/merkle.h"
+#include "consensus/validation.h"
+#include "miner.h"
+#include "pepecoin.h"
+#include "pow.h"
+#include "test/test_bitcoin.h"
+#include "utilstrencodings.h"
+#include "validation.h"
+
+#include <boost/test/unit_test.hpp>
+#include <limits>
+
+struct DoodleverseTestingSetup : public TestingSetup {
+    DoodleverseTestingSetup() : TestingSetup(CBaseChainParams::REGTEST) {}
+
+    CBlock Candidate(const CScript& miner = CScript() << OP_TRUE) {
+        CBlock block = BlockAssembler(Params()).CreateNewBlock(miner, false)->block;
+        block.hashMerkleRoot = BlockMerkleRoot(block);
+        return block;
+    }
+
+    void SetCoinbase(CBlock& block, const CMutableTransaction& tx) {
+        block.vtx[0] = MakeTransactionRef(tx);
+        block.hashMerkleRoot = BlockMerkleRoot(block);
+        block.fChecked = false;
+    }
+
+    std::string Rejection(CBlock block) {
+        LOCK(cs_main);
+        block.hashMerkleRoot = BlockMerkleRoot(block);
+        block.fChecked = false;
+        CValidationState state;
+        const bool accepted = TestBlockValidity(state, Params(), block, chainActive.Tip(), false, true);
+        if (accepted) return "";
+        BOOST_CHECK(state.IsInvalid());
+        return state.GetRejectReason();
+    }
+
+    void Accept(CBlock block) {
+        block.hashMerkleRoot = BlockMerkleRoot(block);
+        block.fChecked = false;
+        while (!CheckProofOfWork(block.GetPoWHash(), block.nBits, Params().GetConsensus(0)))
+            ++block.nNonce;
+        BOOST_REQUIRE(ProcessNewBlock(Params(), std::make_shared<const CBlock>(block), true, nullptr));
+        BOOST_REQUIRE(chainActive.Tip()->GetBlockHash() == block.GetHash());
+    }
+};
+
+BOOST_FIXTURE_TEST_SUITE(doodleverse_tests, DoodleverseTestingSetup)
+
+BOOST_AUTO_TEST_CASE(fixed_cap_and_all_boundaries)
+{
+    const Consensus::Params& params = Params().GetConsensus(0);
+    const uint256 noHash;
+    const int boundaries[] = {1, 210000, 210001, 420000, 420001, 630000,
+        630001, 840000, 840001, 940000, 940001, 1000000};
+    const CAmount expected[] = {50 * COIN, 50 * COIN, 25 * COIN, 25 * COIN,
+        1250000000, 1250000000, 625000000, 625000000, 312500000, 312500000, 0, 0};
+    for (unsigned i = 0; i < sizeof(boundaries) / sizeof(boundaries[0]); ++i)
+        BOOST_CHECK_EQUAL(GetPepecoinBlockSubsidy(boundaries[i], params, noHash), expected[i]);
+    CAmount mined = 0;
+    CAmount founder = 0;
+    for (int height = 0; height <= 1000000; ++height) {
+        const CAmount reward = GetPepecoinBlockSubsidy(height, params, noHash);
+        BOOST_REQUIRE(MoneyRange(reward));
+        mined += reward;
+        founder += GetDoodleverseFounderSubsidy(height);
+        BOOST_REQUIRE(mined <= DVC_MINING_RESERVE);
+    }
+    BOOST_CHECK_EQUAL(mined, 20000000 * COIN);
+    BOOST_CHECK_EQUAL(founder, 1000000 * COIN);
+    BOOST_CHECK_EQUAL(mined + founder, MAX_MONEY);
+    BOOST_CHECK_EQUAL(GetPepecoinBlockSubsidy(0, params, noHash), 0);
+    BOOST_CHECK_EQUAL(GetPepecoinBlockSubsidy(-1, params, noHash), 0);
+    BOOST_CHECK_EQUAL(GetPepecoinBlockSubsidy(std::numeric_limits<int>::max(), params, noHash), 0);
+    BOOST_CHECK_EQUAL(GetDoodleverseFounderSubsidy(0), 0);
+    BOOST_CHECK_EQUAL(GetDoodleverseFounderSubsidy(2), 0);
+}
+
+BOOST_AUTO_TEST_CASE(isolated_networks_and_zero_genesis)
+{
+    const std::string names[] = {CBaseChainParams::MAIN, CBaseChainParams::TESTNET, CBaseChainParams::REGTEST};
+    for (const std::string& name : names) {
+        const CChainParams& network = Params(name);
+        const Consensus::Params& params = network.GetConsensus(0);
+        const CBlock& genesis = network.GenesisBlock();
+        BOOST_CHECK_EQUAL(genesis.vtx.size(), 1U);
+        BOOST_CHECK_EQUAL(genesis.vtx[0]->GetValueOut(), 0);
+        BOOST_CHECK(genesis.vtx[0]->vout[0].scriptPubKey.IsUnspendable());
+        BOOST_CHECK(CheckProofOfWork(genesis.GetPoWHash(), genesis.nBits, params));
+        BOOST_CHECK(genesis.GetHash() == params.hashGenesisBlock);
+        BOOST_CHECK(genesis.GetHash() != genesis.GetPoWHash());
+        BOOST_CHECK(network.DNSSeeds().empty());
+        BOOST_CHECK(network.FixedSeeds().empty());
+        BOOST_CHECK(network.Checkpoints().mapCheckpoints.empty());
+        BOOST_CHECK(params.nMinimumChainWork.IsNull());
+        BOOST_CHECK(params.defaultAssumeValid.IsNull());
+        BOOST_CHECK_EQUAL(params.nCoinbaseMaturity, 30U);
+        BOOST_CHECK_EQUAL(params.nPowTargetSpacing, 60);
+        BOOST_CHECK_EQUAL(params.nSubsidyHalvingInterval, 210000);
+        BOOST_CHECK(params.fDigishieldDifficultyCalculation);
+        BOOST_CHECK_EQUAL(network.GetConsensus(1000000).nHeightEffective, 0U);
+    }
+    for (unsigned i = 0; i < 3; ++i) {
+        for (unsigned j = i + 1; j < 3; ++j) {
+            BOOST_CHECK(Params(names[i]).GenesisBlock().GetHash() != Params(names[j]).GenesisBlock().GetHash());
+            BOOST_CHECK(Params(names[i]).GetDefaultPort() != Params(names[j]).GetDefaultPort());
+            BOOST_CHECK(Params(names[i]).Base58Prefix(CChainParams::PUBKEY_ADDRESS) !=
+                        Params(names[j]).Base58Prefix(CChainParams::PUBKEY_ADDRESS));
+        }
+    }
+    BOOST_CHECK(Params(CBaseChainParams::MAIN).GetConsensus(0).founderScriptPubKey.empty());
+    BOOST_CHECK_EQUAL(HexStr(Params().GetConsensus(0).founderScriptPubKey),
+        "76a914751e76e8199196d454941c45d1b3a323f1433bd688ac");
+    BOOST_CHECK(!pcoinsTip->HaveCoins(Params().GenesisBlock().vtx[0]->GetHash()));
+}
+
+BOOST_AUTO_TEST_CASE(founder_coinbase_full_validation)
+{
+    const CBlock correct = Candidate();
+    BOOST_CHECK_EQUAL(Rejection(correct), "");
+    BOOST_REQUIRE_EQUAL(correct.vtx[0]->vout.size(), 2U);
+    BOOST_CHECK_EQUAL(correct.vtx[0]->vout[0].nValue, 50 * COIN);
+    BOOST_CHECK_EQUAL(correct.vtx[0]->vout[1].nValue, DVC_FOUNDER_ALLOCATION);
+    for (int mutation = 0; mutation < 7; ++mutation) {
+        CBlock block = correct;
+        CMutableTransaction tx(*block.vtx[0]);
+        if (mutation == 0) tx.vout.erase(tx.vout.begin() + 1); // omitted
+        if (mutation == 1) tx.vout[1].scriptPubKey = CScript() << OP_FALSE; // redirected
+        if (mutation == 2) tx.vout.emplace_back(0, tx.vout[1].scriptPubKey); // duplicate
+        if (mutation == 3) --tx.vout[1].nValue; // founder underpaid
+        if (mutation == 4) ++tx.vout[1].nValue; // founder overpaid
+        if (mutation == 5) { // split allocation, still invalid
+            tx.vout[1].nValue /= 2;
+            tx.vout.push_back(tx.vout[1]);
+        }
+        if (mutation == 6) ++tx.vout[0].nValue; // miner overpaid one atomic unit
+        SetCoinbase(block, tx);
+        BOOST_CHECK_EQUAL(Rejection(block), mutation == 6 ? "bad-cb-amount" : "bad-dvc-founder");
+    }
+    // Miners may permanently burn their own allowance, never the founder's.
+    CBlock underclaim = correct;
+    CMutableTransaction tx(*underclaim.vtx[0]);
+    tx.vout[0].nValue = 0;
+    SetCoinbase(underclaim, tx);
+    BOOST_CHECK_EQUAL(Rejection(underclaim), "");
+    Accept(correct);
+    CBlock second = Candidate();
+    BOOST_REQUIRE_EQUAL(second.vtx[0]->vout.size(), 1U);
+    CMutableTransaction repeat(*second.vtx[0]);
+    repeat.vout.emplace_back(DVC_FOUNDER_ALLOCATION, Params().GetConsensus(0).founderScriptPubKey);
+    SetCoinbase(second, repeat);
+    BOOST_CHECK_EQUAL(Rejection(second), "bad-cb-amount");
+}
+
+BOOST_AUTO_TEST_CASE(direct_scrypt_only_and_chain_id)
+{
+    CBlock block = Candidate();
+    const Consensus::Params& params = Params().GetConsensus(0);
+    while (!CheckProofOfWork(block.GetPoWHash(), block.nBits, params)) ++block.nNonce;
+    BOOST_CHECK(CheckAuxPowProofOfWork(block, params));
+    block.SetChainId(0x003f); // Pepecoin's chain ID
+    // Changing the version also changes its Scrypt hash. Re-solve so rejection
+    // proves chain-ID isolation rather than merely insufficient work.
+    while (!CheckProofOfWork(block.GetPoWHash(), block.nBits, params)) ++block.nNonce;
+    BOOST_REQUIRE(CheckProofOfWork(block.GetPoWHash(), block.nBits, params));
+    BOOST_CHECK(!CheckAuxPowProofOfWork(block, params));
+    block.SetChainId(params.nAuxpowChainId);
+    block.SetAuxpowFlag(true);
+    BOOST_CHECK(!CheckAuxPowProofOfWork(block, params));
+    BOOST_CHECK_EQUAL(Rejection(block), "early-auxpow-block");
+}
+
+BOOST_AUTO_TEST_CASE(coinbase_maturity_and_fee_bound)
+{
+    CBlock first = Candidate();
+    const uint256 firstTx = first.vtx[0]->GetHash();
+    Accept(first);
+    CMutableTransaction spend;
+    spend.vin.emplace_back(COutPoint(firstTx, 0));
+    spend.vout.emplace_back(49 * COIN, CScript() << OP_TRUE);
+    CBlock premature = Candidate();
+    premature.vtx.push_back(MakeTransactionRef(spend));
+    BOOST_CHECK_EQUAL(Rejection(premature), "bad-txns-premature-spend-of-coinbase");
+    while (chainActive.Height() < 30) Accept(Candidate());
+    CBlock withFee = Candidate();
+    withFee.vtx.push_back(MakeTransactionRef(spend));
+    CMutableTransaction reward(*withFee.vtx[0]);
+    reward.vout[0].nValue = 51 * COIN; // exactly 50 subsidy plus 1 fee
+    SetCoinbase(withFee, reward);
+    BOOST_CHECK_EQUAL(Rejection(withFee), "");
+    ++reward.vout[0].nValue;
+    CBlock excess = withFee;
+    SetCoinbase(excess, reward);
+    BOOST_CHECK_EQUAL(Rejection(excess), "bad-cb-amount");
+    Accept(withFee);
+    BOOST_CHECK_EQUAL(chainActive.Height(), 31);
+}
+
+BOOST_AUTO_TEST_CASE(founder_rolls_back_with_chain)
+{
+    CBlock first = Candidate();
+    const uint256 oldCoinbase = first.vtx[0]->GetHash();
+    Accept(first);
+    CBlockIndex* oldFirst = chainActive.Tip();
+    Accept(Candidate());
+    BOOST_REQUIRE(pcoinsTip->HaveCoins(oldCoinbase));
+    {
+        LOCK(cs_main);
+        CValidationState state;
+        BOOST_REQUIRE(InvalidateBlock(state, Params(), oldFirst));
+        BOOST_REQUIRE_EQUAL(chainActive.Height(), 0);
+        BOOST_CHECK(!pcoinsTip->HaveCoins(oldCoinbase));
+    }
+    CBlock replacement = Candidate(CScript() << OP_2);
+    const uint256 newCoinbase = replacement.vtx[0]->GetHash();
+    BOOST_REQUIRE(oldCoinbase != newCoinbase);
+    Accept(replacement);
+    Accept(Candidate());
+    Accept(Candidate());
+    {
+        LOCK(cs_main);
+        BOOST_REQUIRE(ResetBlockFailureFlags(oldFirst));
+    }
+    CValidationState state;
+    BOOST_REQUIRE(ActivateBestChain(state, Params()));
+    BOOST_CHECK_EQUAL(chainActive.Height(), 3);
+    BOOST_CHECK(!pcoinsTip->HaveCoins(oldCoinbase));
+    const CCoins* coins = pcoinsTip->AccessCoins(newCoinbase);
+    BOOST_REQUIRE(coins != nullptr);
+    BOOST_REQUIRE_EQUAL(coins->vout.size(), 2U);
+    BOOST_CHECK_EQUAL(coins->vout[1].nValue, DVC_FOUNDER_ALLOCATION);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
