diff --git a/contrib/doodleverse/genesis.py b/contrib/doodleverse/genesis.py
new file mode 100644
index 0000000000000000000000000000000000000000..199dc1788cffb6dfb462e6e7669b02bd6088d56f
--- /dev/null
+++ b/contrib/doodleverse/genesis.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Reproduce Doodleverse's zero-value genesis blocks using Scrypt(1024,1,1).
+
+This searches disposable, public header nonces; it does not create wallet keys.
+Copyright (c) 2026 The Doodleverse developers
+See the GPLv3 text in the Doodle Tick repository's root LICENSE and in the
+accompanying distribution. Upstream MIT notices remain unchanged.
+"""
+import argparse
+import hashlib
+import json
+import struct
+
+
+def hash256(value):
+    return hashlib.sha256(hashlib.sha256(value).digest()).digest()
+
+
+def push(value):
+    assert len(value) < 76
+    return bytes([len(value)]) + value
+
+
+def genesis(network, timestamp, bits, nonce=None):
+    message = ("Doodleverse 2026-11-17 " + network + " independent Scrypt; no genesis allocation").encode()
+    script_sig = bytes.fromhex("04ffff001d0104") + push(message)
+    script_pubkey = b"\x6a" + push(b"DVC genesis: no allocation")
+    tx = (struct.pack("<I", 1) + b"\x01" + bytes(32) + bytes.fromhex("ffffffff")
+          + bytes([len(script_sig)]) + script_sig + bytes.fromhex("ffffffff")
+          + b"\x01" + struct.pack("<Q", 0) + bytes([len(script_pubkey)]) + script_pubkey
+          + struct.pack("<I", 0))
+    merkle = hash256(tx)
+    prefix = struct.pack("<I", 1) + bytes(32) + merkle + struct.pack("<II", timestamp, bits)
+    target = (bits & 0x7fffff) << (8 * ((bits >> 24) - 3))
+    candidate = 0 if nonce is None else nonce
+    while candidate < 0x100000000:
+        header = prefix + struct.pack("<I", candidate)
+        proof = hashlib.scrypt(header, salt=header, n=1024, r=1, p=1, dklen=32)
+        if int.from_bytes(proof, "little") <= target:
+            return {"network": network, "timestamp": timestamp, "bits": hex(bits), "nonce": candidate,
+                    "hash": hash256(header)[::-1].hex(), "merkle_root": merkle[::-1].hex(),
+                    "scrypt_pow": proof[::-1].hex(), "header": header.hex(), "transaction": tx.hex()}
+        if nonce is not None:
+            raise ValueError("Pinned genesis does not satisfy Scrypt proof of work")
+        candidate += 1
+    raise ValueError("Nonce space exhausted")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--verify", action="store_true", help="check pinned nonces instead of searching")
+    args = parser.parse_args()
+    # Filled after the initial public search. No private randomness is used.
+    pinned = {"main": 63487, "test": 253130, "regtest": 1}
+    result = [genesis(name, stamp, bits, pinned[name] if args.verify else None)
+              for name, stamp, bits in (("main", 1794873600, 0x1f00ffff),
+                                        ("test", 1794873660, 0x1f00ffff),
+                                        ("regtest", 1794873720, 0x207fffff))]
+    print(json.dumps(result, indent=2))
