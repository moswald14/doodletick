+bool CheckDoodleverseFounderCoinbase(const CTransaction& coinbase, int nHeight, const Consensus::Params& params)
+{
+    if (nHeight != 1)
+        return true; // No additional allowance after block 1, enforced by the total reward check.
+    if (params.founderScriptPubKey.empty())
+        return false;
+    unsigned matches = 0;
+    for (const CTxOut& output : coinbase.vout) {
+        if (output.scriptPubKey == params.founderScriptPubKey) {
+            ++matches;
+            if (output.nValue != DVC_FOUNDER_ALLOCATION)
+                return false;
+        }
+    }
+    // Exactly one matching output prevents splitting, duplicate zero outputs,
+    // extra miner fees at the founder script, and redirection of the allocation.
+    return matches == 1;
